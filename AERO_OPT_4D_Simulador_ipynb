        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def calcular_haversine_vectorizado(latitudes, longitudes):\n",
        "    \"\"\"Calcula las distancias ortodrómicas entre coordenadas consecutivas en Millas Náuticas (NM).\"\"\"\n",
        "    R_NM = 3440.069 # Radio de la Tierra en NM\n",
        "    lat_rad = np.radians(latitudes)\n",
        "    lon_rad = np.radians(longitudes)\n",
        "\n",
        "    dlat = np.diff(lat_rad)\n",
        "    dlon = np.diff(lon_rad)\n",
        "\n",
        "    a = np.sin(dlat/2.0)**2 + np.cos(lat_rad[:-1]) * np.cos(lat_rad[1:]) * np.sin(dlon/2.0)**2\n",
        "    c = 2 * np.arcsin(np.sqrt(a)) # Corregido: agregado el operador *\n",
        "\n",
        "    return R_NM * c\n",
        "\n",
        "def evaluar_y_graficar_ruta(matriz_ruta):\n",
        "    try:\n",
        "        # 1. Validación de arquitectura de datos y física\n",
        "        if matriz_ruta.shape[1] != 3:\n",
        "            raise ValueError(\"Formato incorrecto. Deben ser 3 columnas: [Lat, Lon, Alt].\")\n",
        "\n",
        "        if np.any(matriz_ruta[:, 2] < 0):\n",
        "            raise ValueError(\"Violación física: Se detectaron altitudes negativas.\")\n",
        "\n",
        "        # 2. Cálculos físicos vectorizados\n",
        "        latitudes = matriz_ruta[:, 0]\n",
        "        longitudes = matriz_ruta[:, 1]\n",
        "        altitudes = matriz_ruta[:, 2]\n",
        "\n",
        "        # Distancia esférica por segmento (Haversine)\n",
        "        distancias_segmentos = calcular_haversine_vectorizado(latitudes, longitudes)\n",
        "        distancia_total = np.sum(distancias_segmentos)\n",
        "\n",
        "        # Rendimiento: Consumo de combustible dinámico basado en altitud promedio por segmento\n",
        "        velocidad_crucero_ktas = 250.0\n",
        "        tiempos_segmentos = distancias_segmentos / velocidad_crucero_ktas # Horas\n",
        "\n",
        "        # Modelo simplificado: a mayor altitud media, menor densidad del aire, menor consumo (kg/h)\n",
        "        altitud_media_segmentos = (altitudes[:-1] + altitudes[1:]) / 2.0\n",
        "        tasa_consumo_base = 1600.0 # kg/h a nivel del mar\n",
        "        factor_eficiencia = 1 - (altitud_media_segmentos / 40000.0) # Corregido: agregado el operador -\n",
        "        consumos_segmentos = tiempos_segmentos * (tasa_consumo_base * factor_eficiencia)\n",
        "\n",
        "        combustible_total = np.sum(consumos_segmentos)\n",
        "\n",
        "        # Cálculo del costo operativo\n",
        "        precio_jet_a1_kg = 1.15\n",
        "        costo_total = combustible_total * precio_jet_a1_kg\n",
        "\n",
        "        print(\" Análisis Aeronáutico Completado:\")\n",
        "        print(f\"   Distancia ortodrómica total: {distancia_total:.2f} NM\")\n",
        "        print(f\"   Combustible total estimado: {combustible_total:.2f} kg\")\n",
        "        print(f\"   Costo de Combustible Estimado: ${costo_total:.2f} USD\\n\")\n",
        "\n",
        "        # 3. Visualización de resultados (Etiquetas con unidades físicas)\n",
        "        fig = plt.figure(figsize=(8, 6))\n",
        "        ax = fig.add_subplot(111, projection='3d')\n",
        "        ax.plot(latitudes, longitudes, altitudes, marker='o', color='blue', linewidth=2)\n",
        "        ax.set_xlabel('Latitud (°)')\n",
        "        ax.set_ylabel('Longitud (°)')\n",
        "        ax.set_zlabel('Altitud (ft)')\n",
        "        plt.title('Perfil de Vuelo y Optimización de Ruta: Comalapa - Ilopango')\n",
        "        plt.show()\n",
        "\n",
        "        return True\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\" Error crítico detectado: {e}\")\n",
        "        return False\n",
        "\n",
        "# Matriz de vuelo (Latitud, Longitud, Altitud en ft)\n",
        "ruta_oficial = np.array([\n",
        "    [13.4408, -89.0558, 101],\n",
        "    [13.4600, -89.1000, 2500],\n",
        "    [13.5000, -89.2500, 3000],\n",
        "    [13.7000, -89.1500, 3400],\n",
        "    [13.6994, -89.1198, 2000]\n",
        "])\n",
        "\n",
        "evaluar_y_graficar_ruta(ruta_oficial)"
      ],
