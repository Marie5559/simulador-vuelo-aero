      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def evaluar_y_graficar_ruta(matriz_ruta):\n",
        "    try:\n",
        "        # 1. Validar que tenga 3 columnas\n",
        "        if matriz_ruta.shape[1] != 3:\n",
        "            raise ValueError(\"Formato incorrecto. Deben ser 3 columnas: [Lat, Lon, Alt].\")\n",
        "\n",
        "        # 2. Validar que no haya altitudes negativas (como -300)\n",
        "        if np.any(matriz_ruta[:, 2] < 0):\n",
        "            raise ValueError(\"Riesgo de colisión: Se detectaron altitudes negativas.\")\n",
        "\n",
        "        # 3. Cálculos de física y rendimiento\n",
        "        distancia = np.sum(np.linalg.norm(np.diff(matriz_ruta[:, 0:2], axis=0), axis=1) * 60)\n",
        "        tiempo = distancia / 250\n",
        "        combustible = tiempo * 1600\n",
        "\n",
        "        print(\" Análisis completado con éxito:\")\n",
        "        print(f\"   Distancia total: {distancia:.2f} NM\")\n",
        "        print(f\"   Combustible estimado: {combustible:.2f} kg\\n\")\n",
        "\n",
        "        # 4. Gráfica 3D limpia\n",
        "        fig = plt.figure(figsize=(8, 6))\n",
        "        ax = fig.add_subplot(111, projection='3d')\n",
        "        ax.plot(matriz_ruta[:,0], matriz_ruta[:,1], matriz_ruta[:,2], marker='o', color='blue', linewidth=2)\n",
        "        ax.set_xlabel('Latitud')\n",
        "        ax.set_ylabel('Longitud')\n",
        "        ax.set_zlabel('Altitud (ft)')\n",
        "        plt.title('Optimización 3D: Comalapa - Ilopango')\n",
        "        plt.show()\n",
        "\n",
        "        return True\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\" Error detectado por el sistema: {e}\")\n",
        "        return False\n",
        "\n",
        "# Tu matriz de vuelo real\n",
        "ruta_oficial = np.array([\n",
        "    [13.4408, -89.0558, 101],\n",
        "    [13.4600, -89.1000, 2500],\n",
        "    [13.5000, -89.2500, 3000],\n",
        "    [13.7000, -89.1500, 3400],\n",
        "    [13.6994, -89.1198, 2000]\n",
        "])\n",
        "\n",
        "# Ejecutar el simulador\n",
        "evaluar_y_graficar_ruta(ruta_oficial)"
      ],
